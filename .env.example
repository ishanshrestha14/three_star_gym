# Supabase project → Settings → API. Only the public (anon/publishable) key
# belongs here. Never put the service-role / secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of the site, no trailing slash. Used for canonical links, Open
# Graph tags and the sitemap. On Vercel it falls back to the production domain.
VITE_SITE_URL=http://localhost:5173

# Umami Cloud website ID (cloud.umami.is → Websites → Edit). Set it in Vercel for
# the Production environment only, so local dev and previews aren't counted.
VITE_UMAMI_WEBSITE_ID=
